{
    "name": "@knguyen1411b/flux",
    "version": "0.0.1",
    "description": "A lightweight, performant, and frame-rate independent smooth scrolling library written in TypeScript.",
    "publishConfig": {
        "access": "public"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "keywords": [
        "scroll",
        "smooth-scroll",
        "lenis",
        "animation",
        "inertia",
        "smooth-scrolling",
        "typescript"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "lint": "eslint .",
        "format:check": "prettier --check .",
        "format:write": "prettier --write .",
        "typecheck": "tsc --noEmit",
        "prepare": "husky"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "^11.0.8",
            "onFail": "download"
        }
    },
    "type": "module",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^25.9.1",
        "eslint": "^10.4.1",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.6.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.5",
        "prettier": "^3.8.3",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.60.0"
    }
}
